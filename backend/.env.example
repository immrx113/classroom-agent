# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yuan_meet
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM（通义千问，兼容 OpenAI 接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# 服务端口
SERVER_PORT=8787

# 文件存储
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# 本机课堂试用：先建独立库，勿对原yuan_meet执行试用迁移
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yuan_classroom_local
ASR_MODE=real
ORGANIZE_MODEL=qwen-plus
INDEX_EMBEDDING_PROVIDER=real
INDEX_EMBEDDING_MODEL=text-embedding-v3
INDEX_EMBEDDING_DIMENSIONS=1024
CLASSROOM_PAID_CALLS_ENABLED=false
CLASSROOM_TRIAL_BUDGET_CNY=10
CLASSROOM_TRIAL_LEDGER=./runtime/classroom-trial.sqlite3

# OSS私有桶；使用RAM子用户凭证，只在本机.env填入，不发到聊天
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=
OSS_PREFIX=audio/

